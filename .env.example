# --- Product Hunt API ---
# Get a free Developer Token (read-only, no OAuth flow needed):
# 1. Go to https://www.producthunt.com/v2/oauth/applications
# 2. Create an application (any name/redirect URL, they don't matter for this use)
# 3. Scroll to the bottom of the app's page -> "Developer Token" -> copy it
PH_API_TOKEN=

# --- WordPress ---
# Your site's base URL, no trailing slash
WP_BASE_URL=https://neuralpaws.com

# WP Admin -> Users -> Your Profile -> Application Passwords -> add a new one
# named "directory-sync". Use that generated password here, NOT your login password.
WP_USERNAME=abhishek
WP_APP_PASSWORD=

# --- Behavior tuning (all optional, sensible defaults in code) ---
# Minimum PH votes to auto-publish live (below this -> draft for review)
AUTO_PUBLISH_VOTE_THRESHOLD=50

# Minimum PH votes to be listed at all, even as a draft
MIN_VOTES_TO_LIST=5

# How many days back to scan on each run (keep small for a daily cron;
# the dedupe logic makes re-scanning overlapping windows harmless)
LOOKBACK_DAYS=2

# Safety cap on GraphQL pagination per topic per run
MAX_PAGES_PER_TOPIC=10

LOG_LEVEL=INFO
